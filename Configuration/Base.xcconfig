// What every build of the app shares.
//
// The bundle identifier and the team belong to whoever signs the build. The
// published app is signed by the project's developer account; a person who
// builds it under their own account sets theirs in Identity.xcconfig, which
// is not committed (copy Identity.example.xcconfig). A simulator build needs
// neither.

MUJINPORTAL_BUNDLE_IDENTIFIER = com.ziyan.mujinportal

// The keychain group the app and its notification extension share.
MUJINPORTAL_KEYCHAIN_GROUP = $(MUJINPORTAL_BUNDLE_IDENTIFIER).shared

// The App Group the app and its extensions share files and settings in.
MUJINPORTAL_APP_GROUP = group.$(MUJINPORTAL_BUNDLE_IDENTIFIER)

// Which of Apple's push services issues the token: a build run from Xcode
// (Debug) gets a sandbox token, an archive for TestFlight or the App Store
// (Release) a production one. A token sent to the other service is rejected
// by Apple and the server then deletes it.
MUJINPORTAL_PUSH_ENVIRONMENT[config=Debug] = sandbox
MUJINPORTAL_PUSH_ENVIRONMENT[config=Release] = production

// The server a first sign-in offers, as a bare host (an xcconfig value cannot
// hold "//"). Empty offers production; the upload job sets it from a secret.
MUJINPORTAL_DEFAULT_SERVER =

// The app and its extensions carry the same version; CI sets the build
// number of each upload to the workflow run number.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Identity.xcconfig"
