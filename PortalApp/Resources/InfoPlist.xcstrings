{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo to attach to a ticket, or scan the QR code on a controller to link it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チケットに添付する写真を撮影したり、コントローラーのQRコードをスキャンしてリンクしたりします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄照片以附加到工单，或扫描控制器上的二维码以关联控制器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝照片以附加到工單，或掃描控制器上的 QR 碼以連結控制器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto aufnehmen, um es an ein Ticket anzuhängen, oder den QR-Code auf einem Controller scannen, um ihn zu verknüpfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo à joindre à un ticket, ou scannez le code QR d'un contrôleur pour le lier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een foto om aan een ticket toe te voegen, of scan de QR-code op een controller om hem te koppelen."
          }
        }
      }
    }
  }
}
