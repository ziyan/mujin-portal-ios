    "No ideas right now. The assistant suggests things when it notices something worth doing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ideas right now. The assistant suggests things when it notices something worth doing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はアイデアがありません。アシスタントは、やる価値のあることに気づいたときに提案します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有想法。助手发现值得做的事时会提出建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有想法。助理發現值得做的事時會提出建議。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade keine Ideen. Der Assistent schlägt etwas vor, wenn ihm etwas Lohnendes auffällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune idée pour le moment. L’assistant en propose quand il remarque quelque chose d’utile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu geen ideeën. De assistent stelt iets voor als hij iets de moeite waard vindt."
          }
        }
      }
    },
