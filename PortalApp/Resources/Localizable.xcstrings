        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了应用无法读取的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回了 App 無法讀取的內容。"
