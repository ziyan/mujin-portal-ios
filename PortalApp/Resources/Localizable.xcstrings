    "Your message was posted. The assistant is answering other people and will not reply to it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was posted. The assistant is answering other people and will not reply to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは投稿されました。アシスタントは他の人に回答中のため、このメッセージには返信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已发送。助手正在回答其他人，不会回复这条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息已送出。助理正在回答其他人，不會回覆這則訊息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachricht wurde gesendet. Der Assistent antwortet gerade anderen und wird darauf nicht antworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message a été envoyé. L’assistant répond à d’autres personnes et ne répondra pas à celui-ci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht is geplaatst. De assistent beantwoordt nu andere mensen en reageert hier niet op."
          }
        }
      }
    },
    "This conversation is too long for the assistant to go on. Start a new one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation is too long for the assistant to go on. Start a new one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は長すぎて、アシスタントは続けられません。新しい会話を始めてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话太长，助手无法继续。请开始新的对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段對話太長，助理無法繼續。請開始新的對話。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung ist zu lang, als dass der Assistent weitermachen könnte. Beginnen Sie eine neue."
          }
        },
        "fr": {
