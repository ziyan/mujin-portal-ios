    "Enter a server address that starts with https://.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a server address that starts with https://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// で始まるサーバーのアドレスを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入以 https:// 开头的服务器地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入以 https:// 開頭的伺服器位址。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine Serveradresse ein, die mit https:// beginnt."
          }
        },
        "fr": {
