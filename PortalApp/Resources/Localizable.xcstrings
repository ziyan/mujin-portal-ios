    "The Active Monitoring board is not on this server yet. This is the ticket queue and recent incidents.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Active Monitoring board is not on this server yet. This is the ticket queue and recent incidents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーにはまだアクティブモニタリングボードがありません。代わりにチケットキューと最近のインシデントを表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器尚无主动监控看板。这里显示工单队列和最近的事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器尚無主動監控看板。這裡顯示工單佇列和最近的事件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktive Überwachungstafel gibt es auf diesem Server noch nicht. Hier sehen Sie die Ticket-Warteschlange und aktuelle Vorfälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau de supervision active n’est pas encore sur ce serveur. Voici la file de tickets et les incidents récents."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het actieve bewakingsbord staat nog niet op deze server. Dit is de ticketwachtrij en recente incidenten."
          }
        }
      }
    },
