            "value": "This code is for %@, not %@. Sign in to that server to link it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは %1$@ 用で、%2$@ 用ではありません。そのサーバーにサインインしてリンクしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
