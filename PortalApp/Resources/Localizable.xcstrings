    "A site is watched from the confidence shown. Paused sites tell you nothing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A site is watched from the confidence shown. Paused sites tell you nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトは表示された信頼度から監視されます。一時停止中のサイトは通知されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点按所示置信度监视。已暂停的站点不会通知您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站點依所示信賴度監視。已暫停的站點不會通知您。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Standort wird ab der angezeigten Sicherheit überwacht. Pausierte Standorte melden nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un site est surveillé à partir de la confiance indiquée. Les sites en pause ne signalent rien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een locatie wordt bewaakt vanaf de getoonde betrouwbaarheid. Gepauzeerde locaties melden niets."
          }
        }
      }
    },
