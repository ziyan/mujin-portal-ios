    "The app is not allowed to change how people sign in. These open in Portal on the web, signed in as you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not allowed to change how people sign in. These open in Portal on the web, signed in as you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリではサインイン方法を変更できません。サインインした状態で Portal のウェブ版が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 无权更改登录方式。它们会以您的身份登录后在网页版 Portal 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 無權變更登入方式。它們會以您的身分登入後在網頁版 Portal 中開啟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App darf die Anmeldung nicht ändern. Diese öffnen sich im Web-Portal, mit Ihrer Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’est pas autorisée à modifier la façon de se connecter. Ces pages s’ouvrent dans Portal sur le web, avec votre session."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app mag niet wijzigen hoe mensen inloggen. Deze openen in Portal op het web, ingelogd als u."
          }
        }
      }
    },
