      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say hello. Type @ to bring in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あいさつしましょう。@ で %@ を呼べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打个招呼吧。输入 @ 可邀请 %@ 加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打聲招呼吧。輸入 @ 可邀請 %@ 加入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie Hallo. Mit @ holen Sie %@ dazu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites bonjour. Tapez @ pour faire intervenir %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg hallo. Typ @ om %@ erbij te halen."
          }
        }
      }
    },
    "Say hello. Type @ to mention someone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say hello. Type @ to mention someone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あいさつしましょう。@ で誰かをメンションできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打个招呼吧。输入 @ 可提及某人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打聲招呼吧。輸入 @ 可提及某人。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie Hallo. Mit @ erwähnen Sie jemanden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites bonjour. Tapez @ pour mentionner quelqu’un."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg hallo. Typ @ om iemand te noemen."
          }
        }
      }
    },
    "Message, or @%@ to ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message, or @%@ to ask"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、または @%@ に質問"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发消息，或 @%@ 提问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳訊息，或 @%@ 提問"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachricht, oder @%@ fragen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message, ou @%@ pour demander"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bericht, of @%@ om te vragen"
          }
        }
      }
    },
    "The assistant": {
      "extractionState": "manual",
      "localizations": {
