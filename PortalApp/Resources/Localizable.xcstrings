    "Paying and changing the plan happen on Stripe's pages, which open in Portal on the web, signed in as you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paying and changing the plan happen on Stripe's pages, which open in Portal on the web, signed in as you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いとプランの変更は Stripe のページで行います。サインインした状態で Portal のウェブ版が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款和更改套餐在 Stripe 的页面上进行,会以您的身份登录后在网页版 Portal 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款和變更方案在 Stripe 的頁面上進行,會以您的身分登入後在網頁版 Portal 中開啟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen und Tarifwechsel laufen über Stripe-Seiten, die sich im Web-Portal öffnen, mit Ihrer Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
