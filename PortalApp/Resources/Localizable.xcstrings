    "The assistant has not remembered anything yet. It files what matters after your conversations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant has not remembered anything yet. It files what matters after your conversations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはまだ何も覚えていません。会話のあとで大事なことを記録します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手还没有记住任何内容。它会在对话之后记录重要的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理還沒有記住任何內容。它會在對話之後記錄重要的事。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent hat sich noch nichts gemerkt. Nach Ihren Unterhaltungen legt er Wichtiges ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant n’a encore rien retenu. Il range l’essentiel après vos conversations."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent heeft nog niets onthouden. Na je gesprekken bewaart hij wat ertoe doet."
          }
        }
      }
    },
