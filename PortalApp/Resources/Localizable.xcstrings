    "Nothing is waiting. Tap the pencil to open a ticket.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is waiting. Tap the pencil to open a ticket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待っているものはありません。鉛筆をタップしてチケットを作成できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待处理的内容。点按铅笔图标即可创建工单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有待處理的內容。點一下鉛筆圖示即可建立工單。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet. Tippen Sie auf den Stift, um ein Ticket zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est en attente. Touchez le crayon pour ouvrir un ticket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wacht niets. Tik op het potlood om een ticket te openen."
