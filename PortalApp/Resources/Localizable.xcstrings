    "Ask the assistant to keep working toward something and check in on it. Start one here or in a conversation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the assistant to keep working toward something and check in on it. Start one here or in a conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに何かを目指して作業を続け、経過を確認してもらいます。ここか会話の中で始められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让助手持续朝某个目标努力并定期检查。可以在这里或在对话中开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓助理持續朝某個目標努力並定期檢查。可以在這裡或在對話中開始。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie den Assistenten dauerhaft auf etwas hinarbeiten und nachsehen. Starten Sie ein Ziel hier oder in einer Unterhaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à l’assistant de poursuivre un objectif et d’y revenir. Lancez-en un ici ou dans une conversation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de assistent aan iets blijven werken en erop terugkomen. Start er een hier of in een gesprek."
          }
        }
      }
    },
