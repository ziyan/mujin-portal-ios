    "Ask your assistant, answer its questions and approve what it wants to do.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your assistant, answer its questions and approve what it wants to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに質問し、その質問に答え、実行したい操作を承認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向助手提问，回答它的问题，并批准它要执行的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向助理提問，回答它的問題，並核准它要執行的操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie Ihren Assistenten, beantworten Sie seine Fragen und genehmigen Sie, was er tun möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez vos questions à l’assistant, répondez aux siennes et approuvez ce qu’il veut faire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel uw assistent vragen, beantwoord zijn vragen en keur goed wat hij wil doen."
          }
        }
      }
    },
