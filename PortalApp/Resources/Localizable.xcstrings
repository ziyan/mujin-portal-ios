        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其数据和快照也会一并删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其資料與快照也會一併刪除。此操作無法復原。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Daten und Snapshots werden ebenfalls gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses données et ses instantanés disparaissent avec lui. Cette action est irréversible."
