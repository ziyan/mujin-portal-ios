    "The Active Monitoring board is not on this server yet. This is the ticket queue and recent incidents.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Active Monitoring board is not on this server yet. This is the ticket queue and recent incidents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーにはまだアクティブモニタリングボードがありません。代わりにチケットキューと最近のインシデントを表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器尚无主动监控看板。这里显示工单队列和最近的事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器尚無主動監控看板。這裡顯示工單佇列和最近的事件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
