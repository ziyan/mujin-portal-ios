    "Speak, then pause. Talking over the answer is not available on this server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak, then pause. Talking over the answer is not available on this server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話してから間を置いてください。このサーバーでは、回答に割り込んで話すことはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说完后停顿一下。此服务器不支持在回答时插话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說完後停頓一下。此伺服器不支援在回答時插話。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen Sie und machen Sie dann eine Pause. Dazwischenreden ist auf diesem Server nicht möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez, puis marquez une pause. Couper la parole à la réponse n’est pas disponible sur ce serveur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek en pauzeer dan. Over het antwoord heen praten kan niet op deze server."
          }
        }
      }
    },
