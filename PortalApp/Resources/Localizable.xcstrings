    "Prices are set per currency and synced to Stripe, which happens in Portal on the web.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are set per currency and synced to Stripe, which happens in Portal on the web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格は通貨ごとに設定され Stripe と同期されます。これは Portal のウェブ版で行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格按币种设置并同步到 Stripe,这在网页版 Portal 中进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格依幣別設定並同步到 Stripe,這在網頁版 Portal 中進行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise werden je Währung festgelegt und mit Stripe abgeglichen, was im Web-Portal geschieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix sont fixés par devise et synchronisés avec Stripe, ce qui se fait dans Portal sur le web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijzen worden per valuta ingesteld en met Stripe gesynchroniseerd, wat in Portal op het web gebeurt."
          }
        }
      }
    },
