    "Notifications always show in the app. Choose which ones also reach this phone, and which are mailed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications always show in the app. Choose which ones also reach this phone, and which are mailed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は常にアプリ内に表示されます。このiPhoneにも届けるものと、メールで送るものを選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知始终显示在应用中。选择哪些也发送到此手机，哪些通过邮件发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知一律顯示在 App 中。選擇哪些也傳送到此手機，哪些以電子郵件寄送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen erscheinen immer in der App. Wählen Sie, welche zusätzlich auf dieses Telefon kommen und welche per E-Mail gesendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications apparaissent toujours dans l’app. Choisissez celles qui arrivent aussi sur ce téléphone et celles envoyées par e-mail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen verschijnen altijd in de app. Kies welke ook op deze telefoon aankomen en welke per e-mail worden verstuurd."
          }
        }
      }
    },
