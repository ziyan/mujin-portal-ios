    "Groups lose the permissions it gave them. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups lose the permissions it gave them. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはこのロールで得た権限を失います。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组将失去它授予的权限。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組將失去它授予的權限。此操作無法復原。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen verlieren die Berechtigungen, die sie ihnen gab. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes perdent les autorisations qu’il leur donnait. Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groepen verliezen de rechten die het gaf. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "Its people lose the access it gave them. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its people lose the access it gave them. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループのメンバーは、与えられていたアクセス権を失います。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其成员将失去它授予的访问权限。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其成員將失去它授予的存取權限。此操作無法復原。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Personen verlieren den Zugriff, den es ihnen gab. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses membres perdent l’accès qu’il leur donnait. Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mensen verliezen de toegang die het gaf. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "Anything using %@ stops working right away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything using %@ stops working right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を使っているものはすぐに動作しなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 的内容会立即停止工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 的內容會立即停止運作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was %@ nutzt, funktioniert sofort nicht mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui utilise %@ cesse de fonctionner immédiatement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat %@ gebruikt, werkt direct niet meer."
          }
        }
      }
    },
    "Anything holding a token can act as you until the token is revoked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything holding a token can act as you until the token is revoked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンを持つものは、取り消されるまであなたとして操作できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持有令牌的任何内容在令牌被撤销前都能以您的身份操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有權杖的任何內容在權杖被撤銷前都能以您的身分操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was ein Token besitzt, kann in Ihrem Namen handeln, bis das Token widerrufen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui détient un jeton peut agir en votre nom jusqu’à sa révocation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles met een token kan als u handelen totdat het token wordt ingetrokken."
          }
        }
      }
    },
    "Every script and tool using one of these stops working right away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every script and tool using one of these stops working right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらを使っているスクリプトやツールはすぐに動作しなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用这些令牌的所有脚本和工具会立即停止工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用這些權杖的所有指令碼和工具會立即停止運作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Skript und Tool, das eines davon nutzt, funktioniert sofort nicht mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les scripts et outils qui en utilisent un cessent de fonctionner immédiatement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk script en hulpmiddel dat er een gebruikt, werkt direct niet meer."
          }
        }
      }
    },
    "Every phone and tablet signed in to Portal with this app shares this permission. To end the sign-in on this one, use Sign out in More.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every phone and tablet signed in to Portal with this app shares this permission. To end the sign-in on this one, use Sign out in More."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリで Portal にサインインしているすべての iPhone と iPad がこの許可を共有します。このデバイスのサインインを終了するには、「その他」でサインアウトしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有使用此 App 登录 Portal 的手机和平板共用此授权。要结束此设备的登录,请在“更多”中退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有使用此 App 登入 Portal 的手機和平板共用此授權。要結束此裝置的登入,請在「更多」中登出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Telefone und Tablets, die mit dieser App bei Portal angemeldet sind, teilen diese Berechtigung. Um die Anmeldung auf diesem Gerät zu beenden, verwenden Sie unter „Mehr“ die Abmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les téléphones et tablettes connectés à Portal avec cette app partagent cette autorisation. Pour terminer la session sur cet appareil, utilisez Se déconnecter dans Plus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle telefoons en tablets die met deze app bij Portal zijn ingelogd, delen deze toestemming. Gebruik Uitloggen onder Meer om de aanmelding op dit apparaat te beëindigen."
          }
        }
      }
    },
    "This app's own sign-in is not listed. To end it, use Sign out in More.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app's own sign-in is not listed. To end it, use Sign out in More."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリ自体のサインインは一覧に含まれません。終了するには、「その他」でサインアウトしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 自身的登录不会列出。要结束它,请在“更多”中退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 自身的登入不會列出。要結束它,請在「更多」中登出。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Anmeldung dieser App wird nicht aufgeführt. Zum Beenden verwenden Sie unter „Mehr“ die Abmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de cette app n’est pas listée. Pour la terminer, utilisez Se déconnecter dans Plus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eigen aanmelding van deze app staat niet in de lijst. Gebruik Uitloggen onder Meer om die te beëindigen."
          }
        }
      }
    },
