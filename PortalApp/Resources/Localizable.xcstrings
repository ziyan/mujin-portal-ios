    "%@ can no longer be used to sign in over SSH.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can no longer be used to sign in over SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ では SSH でサインインできなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将不能再用于通过 SSH 登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將不能再用於透過 SSH 登入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht mehr für die SSH-Anmeldung verwendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut plus servir à se connecter en SSH."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan niet meer worden gebruikt om via SSH in te loggen."
          }
        }
      }
    },
    "%@ can no longer be used to sign in. You can add it again on the web.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can no longer be used to sign in. You can add it again on the web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ではサインインできなくなります。ウェブで再度追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将不能再用于登录。您可以在网页上重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將不能再用於登入。您可以在網頁上重新新增。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht mehr zur Anmeldung verwendet werden. Sie können es im Web erneut hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut plus servir à se connecter. Vous pouvez le rajouter sur le web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan niet meer worden gebruikt om in te loggen. U kunt het op het web opnieuw toevoegen."
          }
        }
      }
    },
    "%@ can no longer connect. It has to be added again on the web.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can no longer connect. It has to be added again on the web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は接続できなくなります。ウェブで再度追加する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将无法再连接。必须在网页上重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將無法再連線。必須在網頁上重新新增。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann sich nicht mehr verbinden. Es muss im Web erneut hinzugefügt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut plus se connecter. Il faut le rajouter sur le web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan geen verbinding meer maken. Het moet op het web opnieuw worden toegevoegd."
          }
        }
      }
    },
    "%@ is signed out and has to ask for your permission again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is signed out and has to ask for your permission again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はサインアウトされ、再度あなたの許可が必要になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将退出登录,需要再次征得您的许可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將登出,需要再次徵得您的許可。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird abgemeldet und muss erneut um Ihre Erlaubnis bitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déconnecté et doit redemander votre autorisation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt uitgelogd en moet opnieuw om uw toestemming vragen."
          }
        }
      }
    },
    "%@ is signed out right away and has to sign in again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is signed out right away and has to sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすぐにサインアウトされ、再度サインインする必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将立即退出登录,需要重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將立即登出,需要重新登入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird sofort abgemeldet und muss sich erneut anmelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déconnecté immédiatement et doit se reconnecter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt meteen uitgelogd en moet opnieuw inloggen."
          }
        }
      }
    },
    "Private to you. Choose up to %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private to you. Choose up to %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなただけに表示されます。最大 %lld 件まで選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅您可见。最多选择 %lld 项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅您可見。最多選擇 %lld 項。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Sie sichtbar. Wählen Sie bis zu %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé. Choisissez-en jusqu’à %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor u. Kies er maximaal %lld."
          }
        }
      }
    },
    "Shown next to your name. Up to %lld characters.": {
      "extractionState": "manual",
      "localizations": {
