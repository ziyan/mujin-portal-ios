    "You can still read what was said while you were in it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still read what was said while you were in it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加していた間の内容は引き続き読めます。"
