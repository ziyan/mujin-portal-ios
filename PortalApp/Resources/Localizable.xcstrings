    "Your organization has turned this off, so the assistant never starts a conversation whatever you choose here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization has turned this off, so the assistant never starts a conversation whatever you choose here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織がこれをオフにしているため、ここでどう選んでもアシスタントから会話を始めることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的组织已将其关闭，所以无论你在这里如何选择，助手都不会主动发起对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的組織已將其關閉，所以無論你在這裡如何選擇，助理都不會主動發起對話。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Organisation hat das ausgeschaltet, daher beginnt der Assistent unabhängig von Ihrer Wahl hier nie eine Unterhaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre organisation l’a désactivé : l’assistant ne commence jamais de conversation, quel que soit votre choix ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je organisatie heeft dit uitgezet, dus de assistent begint nooit een gesprek wat je hier ook kiest."
          }
        }
      }
    },
    "It does this rarely, at most once a day, and only when you are using the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does this rarely, at most once a day, and only when you are using the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはまれで、1日1回までで、アプリを使っているときだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这种情况很少，每天最多一次，而且只在你使用应用时发生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這種情況很少，每天最多一次，而且只在你使用 App 時發生。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geschieht selten, höchstens einmal am Tag und nur, wenn Sie die App benutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrive rarement, au plus une fois par jour, et seulement quand vous utilisez l’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gebeurt zelden, hooguit één keer per dag en alleen als je de app gebruikt."
          }
        }
      }
    },
