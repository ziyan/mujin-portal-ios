            "state": "translated",
            "value": "Dites bonjour. Tapez @ pour faire intervenir %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg hallo. Typ @ om %@ erbij te halen."
          }
        }
