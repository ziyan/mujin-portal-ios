    "The tab bar is full. Remove a screen to add another. More always stays last.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is full. Remove a screen to add another. More always stays last."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーがいっぱいです。別の画面を追加するには、画面を1つ削除してください。「その他」は常に最後に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏已满。请先移除一个页面再添加其他页面。“更多”始终排在最后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列已滿。請先移除一個頁面再新增其他頁面。「更多」永遠排在最後。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist voll. Entfernen Sie einen Bildschirm, um einen anderen hinzuzufügen. „Mehr“ bleibt immer ganz hinten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d’onglets est pleine. Retirez un écran pour en ajouter un autre. « Plus » reste toujours en dernier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tabbalk is vol. Verwijder een scherm om een ander toe te voegen. Meer blijft altijd laatst."
          }
        }
      }
    },
