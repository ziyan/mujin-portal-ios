    "That was already answered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was already answered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに回答済みです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这已经回答过了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這已經回答過了。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wurde bereits beantwortet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a déjà une réponse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is al beantwoord."
          }
        }
      }
    },
    "That question timed out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That question timed out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この質問は時間切れになりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个问题已超时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個問題已逾時。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Frage ist abgelaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette question a expiré."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vraag is verlopen."
          }
        }
      }
    },
    "That was cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was cancelled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这已被取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這已被取消。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wurde abgebrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a été annulé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is geannuleerd."
          }
        }
      }
    },
    "Your message was posted. The assistant is answering other people and will not reply to it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was posted. The assistant is answering other people and will not reply to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは投稿されました。アシスタントは他の人に回答中のため、このメッセージには返信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已发送。助手正在回答其他人，不会回复这条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息已送出。助理正在回答其他人，不會回覆這則訊息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Nachricht wurde gesendet. Der Assistent antwortet gerade anderen und wird darauf nicht antworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message a été envoyé. L’assistant répond à d’autres personnes et ne répondra pas à celui-ci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht is geplaatst. De assistent beantwoordt nu andere mensen en reageert hier niet op."
          }
        }
      }
    },
    "This conversation is too long for the assistant to go on. Start a new one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation is too long for the assistant to go on. Start a new one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は長すぎて、アシスタントは続けられません。新しい会話を始めてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话太长，助手无法继续。请开始新的对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段對話太長，助理無法繼續。請開始新的對話。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung ist zu lang, als dass der Assistent weitermachen könnte. Beginnen Sie eine neue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation est trop longue pour que l’assistant continue. Commencez-en une nouvelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gesprek is te lang om door te gaan. Begin een nieuw gesprek."
          }
        }
      }
    },
    "The assistant's model provider rejected its credentials. An administrator needs to fix this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant's model provider rejected its credentials. An administrator needs to fix this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントのモデルプロバイダーが認証情報を拒否しました。管理者の対応が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手的模型提供方拒绝了其凭据。需要管理员来修复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理的模型供應商拒絕了其憑證。需要管理員來修復。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellanbieter des Assistenten hat dessen Zugangsdaten abgelehnt. Ein Administrator muss das beheben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur de modèle de l’assistant a refusé ses identifiants. Un administrateur doit corriger cela."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De modelprovider van de assistent heeft de inloggegevens geweigerd. Een beheerder moet dit oplossen."
          }
        }
      }
    },
    "The model provider is busy. Try again in a minute.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model provider is busy. Try again in a minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルプロバイダーが混み合っています。1分ほどしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型提供方繁忙，请一分钟后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型供應商忙碌中，請一分鐘後再試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellanbieter ist ausgelastet. Versuchen Sie es in einer Minute erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur de modèle est occupé. Réessayez dans une minute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De modelprovider is druk. Probeer het over een minuut opnieuw."
          }
        }
      }
    },
    "The model provider is not available right now. Try again soon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model provider is not available right now. Try again soon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルプロバイダーは現在利用できません。しばらくしてからお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型提供方目前不可用，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型供應商目前無法使用，請稍後再試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellanbieter ist gerade nicht erreichbar. Versuchen Sie es bald erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur de modèle n’est pas disponible pour le moment. Réessayez bientôt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De modelprovider is nu niet beschikbaar. Probeer het straks opnieuw."
          }
        }
      }
    },
    "The model provider refused the request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model provider refused the request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルプロバイダーがリクエストを拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型提供方拒绝了请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型供應商拒絕了請求。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellanbieter hat die Anfrage abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur de modèle a refusé la requête."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De modelprovider heeft het verzoek geweigerd."
          }
        }
      }
    },
