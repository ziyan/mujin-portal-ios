    },
    "This chat becomes a group with them in it. They can read everything said in it so far.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat becomes a group with them in it. They can read everything said in it so far."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは追加した人を含むグループになります。追加した人はこれまでのすべてのメッセージを閲覧できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天将变为包含他们的群组。他们能看到此前的全部消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天將變成包含他們的群組。他們能看到先前的所有訊息。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat wird zu einer Gruppe mit ihnen. Sie können alles lesen, was bisher darin gesagt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation devient un groupe qui les inclut. Elles peuvent lire tout ce qui y a été dit jusqu'ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze chat wordt een groep met hen erin. Ze kunnen alles lezen wat er tot nu toe in is gezegd."
          }
        }
      }
    },
    "They join this group and can read everything said in it so far.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They join this group and can read everything said in it so far."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループに参加し、これまでのすべてのメッセージを閲覧できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们将加入该群组，并能看到此前的全部消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
