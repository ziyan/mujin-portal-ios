    "Approving creates the organization, which the app is not allowed to do. It opens in Portal on the web, signed in as you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving creates the organization, which the app is not allowed to do. It opens in Portal on the web, signed in as you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると組織が作成されますが、アプリでは行えません。サインインした状態で Portal のウェブ版が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准会创建组织,App 无权执行。它会以您的身份登录后在网页版 Portal 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准會建立組織,App 無權執行。它會以您的身分登入後在網頁版 Portal 中開啟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Genehmigen wird die Organisation angelegt, was die App nicht darf. Es öffnet sich im Web-Portal, mit Ihrer Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver crée l’organisation, ce que l’app n’est pas autorisée à faire. Cela s’ouvre dans Portal sur le web, avec votre session."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren maakt de organisatie aan, wat de app niet mag. Het opent in Portal op het web, ingelogd als u."
          }
        }
      }
    },
