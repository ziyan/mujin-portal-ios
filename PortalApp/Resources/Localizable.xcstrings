    "Your organization has turned remembering off, so nothing is remembered whatever you choose here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization has turned remembering off, so nothing is remembered whatever you choose here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織が記憶をオフにしているため、ここでどう選んでも何も記憶されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的组织已关闭记忆功能，所以无论你在这里如何选择，都不会记住任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的組織已關閉記憶功能，所以無論你在這裡如何選擇，都不會記住任何內容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Organisation hat das Merken ausgeschaltet, daher wird unabhängig von Ihrer Wahl hier nichts gemerkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre organisation a désactivé la mémoire : rien n’est retenu, quel que soit votre choix ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je organisatie heeft onthouden uitgezet, dus er wordt niets onthouden wat je hier ook kiest."
          }
        }
      }
    },
    "After a conversation has been quiet for five minutes, the assistant files what matters into what it knows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a conversation has been quiet for five minutes, the assistant files what matters into what it knows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が5分間静かになると、アシスタントは大事なことを記録します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话安静五分钟后，助手会把重要的内容记入它所知道的东西中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話安靜五分鐘後，助理會把重要的內容記入它所知道的東西中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist eine Unterhaltung fünf Minuten ruhig, legt der Assistent Wichtiges in seinem Wissen ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après cinq minutes sans échange, l’assistant range l’essentiel dans ce qu’il sait."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een gesprek vijf minuten stil is, bewaart de assistent wat ertoe doet bij wat hij weet."
          }
        }
      }
    },
