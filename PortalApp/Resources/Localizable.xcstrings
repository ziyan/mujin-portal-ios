        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们将无法登录。您以后可以重新启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們將無法登入。您之後可以重新啟用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können sich nicht mehr anmelden. Sie können sie später wieder aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne peut plus se connecter. Vous pourrez la réactiver plus tard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze kunnen niet meer inloggen. U kunt ze later weer activeren."
          }
        }
      }
    },
