    "The detector rates each incident from 0 to 100. Leave empty to hear about every one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The detector rates each incident from 0 to 100. Leave empty to hear about every one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出器は各インシデントを 0 から 100 で評価します。すべて通知する場合は空のままにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测器会为每个事件打 0 到 100 分。留空则通知所有事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測器會為每個事件評 0 到 100 分。留空則通知所有事件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Detektor bewertet jeden Vorfall von 0 bis 100. Leer lassen, um über jeden informiert zu werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le détecteur note chaque incident de 0 à 100. Laissez vide pour les recevoir tous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De detector beoordeelt elk incident van 0 tot 100. Laat leeg om ze allemaal te horen."
          }
        }
      }
    },
