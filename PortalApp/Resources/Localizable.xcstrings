        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“更多”始终排在最后，其余内容都收在其中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「更多」永遠排在最後，其餘內容都收在其中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Mehr“ bleibt immer ganz hinten und enthält alles andere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Plus » reste toujours en dernier et regroupe tout le reste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer blijft altijd laatst en bevat al het andere."
          }
        }
      }
    },
