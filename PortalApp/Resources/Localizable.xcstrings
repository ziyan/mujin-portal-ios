    "Portal did not allow this camera's video. Ask an administrator for access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal did not allow this camera's video. Ask an administrator for access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal がこのカメラの映像を許可しませんでした。管理者にアクセスを依頼してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal 不允许访问此摄像头的视频。请向管理员申请访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal 不允許存取此攝影機的影像。請向管理員申請存取權限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal hat das Video dieser Kamera nicht erlaubt. Bitten Sie einen Administrator um Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal n’a pas autorisé la vidéo de cette caméra. Demandez l’accès à un administrateur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal liet de video van deze camera niet toe. Vraag een beheerder om toegang."
          }
        }
      }
    },
    "The clip could not be prepared. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
