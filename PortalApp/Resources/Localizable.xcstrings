    "Portal on iPhone and iPad follows the language and the light or dark appearance of this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal on iPhone and iPad follows the language and the light or dark appearance of this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone / iPad 版 Portal は、このデバイスの言語とライト/ダークの外観に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 iPad 版 Portal 会跟随此设备的语言和浅色/深色外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 與 iPad 版 Portal 會跟隨此裝置的語言與淺色/深色外觀。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal auf iPhone und iPad folgt der Sprache und dem hellen oder dunklen Erscheinungsbild dieses Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal sur iPhone et iPad suit la langue et l’apparence claire ou sombre de cet appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal op iPhone en iPad volgt de taal en het lichte of donkere uiterlijk van dit apparaat."
          }
        }
      }
    },
