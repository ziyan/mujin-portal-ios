          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een serveradres in dat met https:// begint."
          }
        }
      }
    },
    "The server sent an answer the app cannot read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
