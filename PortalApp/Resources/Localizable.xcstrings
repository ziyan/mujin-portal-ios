    "The sign-in for %@ on %@ has ended. Sign in again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in for %@ on %@ has ended. Sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@ のサインインは終了しました。もう一度サインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上 %1$@ 的登录已失效。请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上 %1$@ 的登入已失效。請重新登入。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung von %1$@ auf %2$@ ist beendet. Bitte melden Sie sich erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de %1$@ sur %2$@ a pris fin. Reconnectez-vous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanmelding van %1$@ op %2$@ is beëindigd. Meld u opnieuw aan."
          }
        }
      }
    },
    "%@ does not support signing in from this app yet (%@). Ask its administrator to update Portal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not support signing in from this app yet (%@). Ask its administrator to update Portal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はまだこのアプリからのサインインに対応していません（%2$@）。管理者に Portal の更新を依頼してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 暂不支持从此应用登录（%2$@）。请联系其管理员更新 Portal。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 尚不支援從此 App 登入（%2$@）。請聯絡其管理員更新 Portal。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ unterstützt die Anmeldung über diese App noch nicht (%2$@). Bitten Sie den Administrator, Portal zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne prend pas encore en charge la connexion depuis cette app (%2$@). Demandez à son administrateur de mettre Portal à jour."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ondersteunt aanmelden via deze app nog niet (%2$@). Vraag de beheerder om Portal bij te werken."
          }
        }
      }
    },
    "The sign-in page could not be opened.": {
      "extractionState": "manual",
