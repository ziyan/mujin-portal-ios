    "A person who joins the organization and is in no group is put in the default group.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person who joins the organization and is in no group is put in the default group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織に参加してどのグループにも属さないユーザーは、デフォルトグループに入ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入组织但不在任何群组中的人会被放入默认群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入組織但不在任何群組中的人會被放入預設群組。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer der Organisation beitritt und in keiner Gruppe ist, kommt in die Standardgruppe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne qui rejoint l’organisation sans être dans un groupe est placée dans le groupe par défaut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie zich bij de organisatie voegt en in geen groep zit, komt in de standaardgroep."
          }
        }
      }
    },
