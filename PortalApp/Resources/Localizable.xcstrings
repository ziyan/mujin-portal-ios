    "Usage past the limit is blocked until the next period or the limit is raised.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage past the limit is blocked until the next period or the limit is raised."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を超える利用は、次の期間になるか上限が引き上げられるまでブロックされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过上限的使用会被阻止,直到下一周期或上限提高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過上限的使用會被封鎖,直到下一期或上限提高。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzung über dem Limit wird gesperrt, bis die nächste Periode beginnt oder das Limit erhöht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation au-delà du plafond est bloquée jusqu’à la prochaine période ou jusqu’à ce que le plafond soit relevé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik boven de limiet wordt geblokkeerd tot de volgende periode of tot de limiet wordt verhoogd."
          }
        }
      }
    },
