          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Clip konnte nicht vorbereitet werden. Versuchen Sie es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
