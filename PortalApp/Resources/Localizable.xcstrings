    "The connection was interrupted before the answer finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was interrupted before the answer finished."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が完了する前に接続が中断されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在回答完成之前连接中断了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在回答完成之前連線中斷了。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen, bevor die Antwort fertig war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été interrompue avant la fin de la réponse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding werd verbroken voordat het antwoord klaar was."
          }
        }
      }
    },
    "The assistant stopped before it finished. Ask it to go on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant stopped before it finished. Ask it to go on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントは完了前に停止しました。続けるように頼んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手在完成之前停止了。请让它继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理在完成之前停止了。請請它繼續。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent hat angehalten, bevor er fertig war. Bitten Sie ihn weiterzumachen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant s’est arrêté avant d’avoir fini. Demandez-lui de continuer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent stopte voordat hij klaar was. Vraag hem door te gaan."
          }
        }
      }
    },
    "The assistant stopped after %@ steps without finishing. Ask it to go on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant stopped after %@ steps without finishing. Ask it to go on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントは%@ステップ後、完了せずに停止しました。続けるように頼んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手在%@步之后未完成就停止了。请让它继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理在%@步之後未完成就停止了。請請它繼續。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent hat nach %@ Schritten angehalten, ohne fertig zu sein. Bitten Sie ihn weiterzumachen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant s’est arrêté après %@ étapes sans avoir fini. Demandez-lui de continuer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent stopte na %@ stappen zonder klaar te zijn. Vraag hem door te gaan."
          }
        }
      }
    },
    "The assistant stopped because a tool kept failing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant stopped because a tool kept failing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールが失敗し続けたため、アシスタントは停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于某个工具持续失败，助手停止了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於某個工具持續失敗，助理停止了。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent hat angehalten, weil ein Werkzeug immer wieder fehlgeschlagen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant s’est arrêté parce qu’un outil échouait sans cesse."
